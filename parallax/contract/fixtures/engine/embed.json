{
 "b8228084188ebad5": {
  "text": "The Shelling of Mainila on 26 November 1939 was staged by the Soviet Union to justify the invasion of Finland.",
  "copy_of": "en:7aee25bc3466a2fc",
  "emb": ""
 },
 "ae7c5b098cba9d17": {
  "text": "According to the Soviet report, four Soviet soldiers were killed in the incident.",
  "copy_of": "sv:a37b690a0d1e8d7f",
  "emb": ""
 },
 "7ddf75c1046f392a": {
  "text": "Finnish artillery could not reach the village of Mainila.",
  "copy_of": "sv:fafe6f169258cd13",
  "emb": ""
 }
}
