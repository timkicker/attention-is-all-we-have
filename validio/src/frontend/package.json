{
  "name": "validio-web",
  "private": true,
  "type": "module",
  "scripts": {
    "kit": "sh scripts/fetch-ui-kit.sh",
    "dev": "vite dev --host 127.0.0.1 --port 5410 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5410 --strictPort",
    "check": "node scripts/check-tokens.mjs && node scripts/test-check-tokens.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
