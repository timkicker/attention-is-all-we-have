VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
VALIO_MODE=replay              # live | record | replay
VALIO_LIVE_FALLBACK=0          # 1: in replay, a product or day without a recording is asked from Valio's test API
                               # (needs VALIO_API_KEY) and stored for the next replay. make demo turns it on
VALIDIO_SEMANTIC=              # 1: the local semantic search adds candidates (make embed first). make demo turns it on
VALIO_MAX_IDS_PER_REQUEST=40
VALIO_CUSTOMER=hotel-espoo
GEMINI_API_KEY=
GEMINI_MODEL=
GEMMA_MODEL=
LLM_MODE=fake                  # fake | gemini
READER_MODE=fake               # fake | gemini | modal
MODAL_GEMMA_URL=
MODAL_GEMMA_TOKEN=
NVIDIA_API_KEY=
DATABASE_URL=                  # empty means sqlite data/validio.db
VALIDIO_KITCHEN_KEY=data/keys/kitchen-es256.json
VALIDIO_NOW=2026-11-14T10:00:00+02:00
VALIDIO_REAL_TIME=             # 1: ledger, orders and the agent link stamped with the real time; decisions keep VALIDIO_NOW
VALIDIO_DEMO=1                 # the demo reset; off when unset
VALIDIO_APPROVE_CODE=          # 6 digits; when set, approve and reject need it. Always set it on a public link
VALIDIO_KITCHEN_TOKEN=         # callers not on this machine need it (X-Kitchen-Token or POST /api/session) for /api
VALIDIO_PUBLIC=                # 1 on a public deploy: nobody counts as local, and the app refuses to start
                               # without VALIDIO_APPROVE_CODE and VALIDIO_KITCHEN_TOKEN
VALIDIO_MCP_HOSTS=             # extra Host names MCP answers on, comma separated (the Modal hostname)
# 1 = Valio placeholder stock (9999999999, 666666666) is no real count. Off until a Valio mentor answers.
STRICT_PLACEHOLDER_STOCK=0
